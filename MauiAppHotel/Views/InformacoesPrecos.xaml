<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.InformacoesPrecos"
             Title="InformacoesPrecos"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand" Padding="10">
        <Label Text="Informações de Preços" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="40" TextColor="{StaticResource Primary}"/>

        <Frame Padding="10" Margin="10">
            <VerticalStackLayout>
                <Label Text="Suíte Super Luxo" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="20" TextColor="{StaticResource SecondaryDarkText}"/>
                <Label Text="Diária Adulto: R$110,00" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="10" />
                <Label Text="Diária Criança: R$55,00" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="10" />


                <BoxView HeightRequest="15" Opacity="0" />

                <Label Text="Suíte Luxo" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="20" TextColor="{StaticResource SecondaryDarkText}"/>
                <Label Text="Diária Adulto: R$80,00" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="10" />
                <Label Text="Diária Criança: R$40,00" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="10" />

                <BoxView HeightRequest="15" Opacity="0" />

                <Label Text="Suíte Single" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="20" TextColor="{StaticResource SecondaryDarkText}"/>
                <Label Text="Diária Adulto: R$50,00" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="10" />
                <Label Text="Diária Criança: R$25,00" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="10" />

                <BoxView HeightRequest="15" Opacity="0" />

                <Label Text="Suíte Crise" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="20" TextColor="{StaticResource SecondaryDarkText}"/>
                <Label Text="Diária Adulto: R$25,00" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="10" />
                <Label Text="Diária Criança: R$12,50" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="10" />

                <BoxView HeightRequest="15" Opacity="0" />

                <Button Text="Voltar" Clicked="Button_Clicked"/>
            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>