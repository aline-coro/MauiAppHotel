<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand" Padding="10">
        <Label Text="Sobre o Aplicativo" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="50" TextColor="{StaticResource Primary}"/>

        <Frame Padding="10" Margin="10">
            <VerticalStackLayout>
                <Label Text="Hotel - Cálculo de Diárias" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="20" TextColor="{StaticResource SecondaryDarkText}"/>
                <Label Text="Aplicativo desenvolvido para auxiliar no cálculo de hospedagens, considerando a quantidade de hóspedes, a acomodação e o período da estadia." HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="10" />

                <BoxView HeightRequest="15" Opacity="0" />

                <Label Text="Informações do Desenvolvimento" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="20" TextColor="{StaticResource SecondaryDarkText}"/>
                <Label Text="Desenvolvido por Aline Coro em 2026." HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="10" />

                <BoxView HeightRequest="15" Opacity="0" />

                <Label Text="Objetivo" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="20" TextColor="{StaticResource SecondaryDarkText}"/>
                <Label Text="Facilitar a consulta e o cálculo de diárias de hospedagem." HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="10" />

                <BoxView HeightRequest="15" Opacity="0" />

                <Label Text="Versão" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="20" TextColor="{StaticResource SecondaryDarkText}"/>
                <Label Text="1.0.0" HorizontalTextAlignment="Center" FontFamily="ChewyRegular" FontSize="10" />

                <BoxView HeightRequest="15" Opacity="0" />

                <Button Text="Voltar" Clicked="Button_Clicked"/>
            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>